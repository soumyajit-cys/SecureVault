# Keep the Render image lean and secret-free: dependency install happens
# from requirements.txt, so caches, tests, local vault data, virtualenvs,
# node_modules and env files must never enter the build context.
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
node_modules/
frontend/dist/
.git/
.github/
backend/tests/
backend/.venv/
storage/
tmp/
vault/
uploads/
backend/storage/
.env
.env.*
!.env.example
*.pem
Dockerfile
docker-compose.yml
render.yaml
docs/
release/
scripts/
