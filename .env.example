# SecureVault — environment template
# Copy to `.env` and fill in real values.

APP_NAME=SecureVault
APP_ENV=development

API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/securevault
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

PASSWORD_MIN_LENGTH=12

# Bootstrap admin account (created on first startup if missing)
VAULT_ADMIN_EMAIL=admin@securevault.io
VAULT_ADMIN_USERNAME=admin
VAULT_ADMIN_PASSWORD=change-me-Str0ng!AdminPass

STORAGE_DIR=storage

ENCRYPTED_FILE_EXTENSION=.svlt
ENCRYPTED_ARCHIVE_EXTENSION=.svltz

KEY_ROTATION_INTERVAL_DAYS=90
KEY_RETENTION_DAYS=365

GARBAGE_COLLECTION_ENABLED=true
GARBAGE_COLLECTION_INTERVAL_HOURS=24
TEMP_FILE_MAX_AGE_HOURS=24

# CORS / hardening
CORS_ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
TRUSTED_PROXY_COUNT=1

ENABLE_METRICS=true
ENABLE_SECURITY_HEADERS=true