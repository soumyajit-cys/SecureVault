# SecureVault — environment template
# Copy to `.env` and fill in real values.

APP_NAME=SecureVault
APP_ENV=development

API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/securevault
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

PASSWORD_MIN_LENGTH=12

STORAGE_DIR=storage

ENCRYPTED_FILE_EXTENSION=.svlt
ENCRYPTED_ARCHIVE_EXTENSION=.svltz

KEY_ROTATION_INTERVAL_DAYS=90
KEY_RETENTION_DAYS=365

GARBAGE_COLLECTION_ENABLED=true
GARBAGE_COLLECTION_INTERVAL_HOURS=24
TEMP_FILE_MAX_AGE_HOURS=24

MAX_UPLOAD_SIZE_BYTES=4294967296